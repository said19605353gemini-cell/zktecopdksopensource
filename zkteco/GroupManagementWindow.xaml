<Window x:Class="ZkPdksApp.GroupManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Grup ve İstihdam Türü (Statü) Yönetimi" Height="580" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        TextElement.Foreground="#F8FAFC">
    <Window.Resources>
        <Style x:Key="ModernGlassCard" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.3" ShadowDepth="4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK KARTI -->
        <Border Grid.Row="0" Style="{StaticResource ModernGlassCard}" Padding="16,12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="8" Background="#0F172A" Padding="8" Margin="0,0,12,0" BorderBrush="#38BDF8" BorderThickness="1">
                    <materialDesign:PackIcon Kind="AccountMultiplePlus" Width="28" Height="28" Foreground="#38BDF8" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Departman, Grup ve İstihdam Türü (Statü) Yönetimi" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Taşeron, Kadrolu, Üretim, Saha gibi grupları ve istihdam statülerini çoğaltabilir, silebilir ve yönetebilirsiniz." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2 SÜTUN: SOL = ÇALIŞMA GRUPLARI / DEPARTMANLAR, SAĞ = İSTİHDAM TÜRLERİ (TAŞERON / KADROLU VB.) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: ÇALIŞMA GRUPLARI / DEPARTMANLAR -->
            <Border Grid.Column="0" Style="{StaticResource ModernGlassCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Domain" Width="22" Height="22" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Çalışma Grupları / Departmanlar" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Ekleme Alanı -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBox x:Name="txtNewGroupName" Foreground="#F8FAFC" materialDesign:HintAssist.Hint="Grup Adı (Örn: Üretim, Montaj, Depo) *" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtNewGroupDesc" Foreground="#94A3B8" materialDesign:HintAssist.Hint="Açıklama (Opsiyonel)" Margin="0,0,0,10"/>
                            <Button Content="+ Yeni Grup Ekle" Click="BtnAddGroup_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Height="32" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Liste -->
                    <DataGrid Grid.Row="2" x:Name="dgGroups" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" RowBackground="#171E2B" AlternatingRowBackground="#1D2636"
                              BorderThickness="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#253246" VerticalGridLinesBrush="#253246"
                              SelectionMode="Single" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Grup / Departman Adı" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Silme Butonu -->
                    <Button Grid.Row="3" Content="Seçili Grubu Sil" Click="BtnDeleteGroup_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#EF4444" Foreground="#F87171" HorizontalAlignment="Right" Height="32"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- SAĞ PANEL: İSTİHDAM TÜRLERİ / STATÜLER (TAŞERON, KADROLU, VB.) -->
            <Border Grid.Column="2" Style="{StaticResource ModernGlassCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="BadgeAccountHorizontal" Width="22" Height="22" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="İstihdam Türleri / Statüler (Taşeron, Kadrolu...)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Ekleme Alanı -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBox x:Name="txtNewTypeName" Foreground="#F8FAFC" materialDesign:HintAssist.Hint="Statü Adı (Örn: Taşeron, Kadrolu, Yevmiyeli) *" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtNewTypeDesc" Foreground="#94A3B8" materialDesign:HintAssist.Hint="Açıklama (Opsiyonel)" Margin="0,0,0,10"/>
                            <Button Content="+ Yeni Statü / Tür Ekle" Click="BtnAddEmploymentType_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#059669" BorderBrush="#10B981" Foreground="White" Height="32" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Liste -->
                    <DataGrid Grid.Row="2" x:Name="dgEmploymentTypes" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" RowBackground="#171E2B" AlternatingRowBackground="#1D2636"
                              BorderThickness="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#253246" VerticalGridLinesBrush="#253246"
                              SelectionMode="Single" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="İstihdam / Statü Türü" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Silme Butonu -->
                    <Button Grid.Row="3" Content="Seçili Statüyü Sil" Click="BtnDeleteEmploymentType_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#EF4444" Foreground="#F87171" HorizontalAlignment="Right" Height="32"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
