                        <!-- Sağ Kart: Bu Personelin Gün Gün Çalıştığı Günlerin Detaylı Tablosu -->
                        <Border Grid.Column="2" Style="{StaticResource ModernGlassCard}" Padding="8">
                            <DataGrid x:Name="dgEmpDailyDetails" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      Background="Transparent" RowBackground="#171E2B" AlternatingRowBackground="#1D2636"
                                      BorderThickness="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#253246" VerticalGridLinesBrush="#253246"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateString}" Width="100"/>
                                    <DataGridTextColumn Header="Gün" Binding="{Binding DayType}" Width="95"/>
                                    <DataGridTextColumn Header="İlk Giriş" Binding="{Binding ActualFirstIn}" Width="90"/>
                                    <DataGridTextColumn Header="Son Çıkış" Binding="{Binding ActualLastOut}" Width="90"/>
                                    <DataGridTextColumn Header="12 Öncesi Çal.(s)" Binding="{Binding DayWorkHours}" Width="110"/>
                                    <DataGridTextColumn Header="12 Sonrası Gece Çal.(s)" Binding="{Binding NightWorkHours}" Width="125"/>
                                    <DataGridTextColumn Header="Mola(dk)" Binding="{Binding ActualBreakMinutes}" Width="85"/>
                                    <DataGridTextColumn Header="Mola Aşımı(dk)" Binding="{Binding ExcessBreakMinutes}" Width="95"/>
                                    <DataGridTextColumn Header="Net Çalışma" Binding="{Binding NetWorkHours}" Width="100"/>
                                    <DataGridTextColumn Header="Sabah Mesai(s)" Binding="{Binding MorningOvertimeHours}" Width="100"/>
                                    <DataGridTextColumn Header="Akşam Mesai(s)" Binding="{Binding EveningOvertimeHours}" Width="100"/>
                                    <DataGridTextColumn Header="Gece Mesai(s)" Binding="{Binding NightShiftOvertimeHours}" Width="100"/>
                                    <DataGridTextColumn Header="Ham Mesai" Binding="{Binding ApprovedOvertime}" Width="90"/>
                                    <DataGridTextColumn Header="Çarpan" Binding="{Binding OvertimeMultiplier}" Width="75"/>
                                    <DataGridTextColumn Header="Hakediş Mesai" Binding="{Binding WeightedOvertimeHours}" Width="105"/>
                                    <DataGridTextColumn Header="Geç Kalma (dk)" Binding="{Binding LateMinutes}" Width="100"/>
                                    <DataGridTextColumn Header="Eksik (s)" Binding="{Binding MissingWorkHours}" Width="85"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
