<Window x:Class="ZkPdksApp.IrregularPunchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Parmak İzi / Kart Okutma Düzensizlik Takip &amp; İkaz Paneli" Height="680" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        TextElement.Foreground="#0F172A">
    <Window.Resources>
        <Style x:Key="ModernGlassCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#0F172A" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BİLGİ VE UYARI KARTI -->
        <Border Grid.Row="0" Style="{StaticResource ModernGlassCard}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#FEF2F2" Padding="8" Margin="0,0,12,0" BorderBrush="#FECACA" BorderThickness="1">
                        <materialDesign:PackIcon Kind="AlertDecagramOutline" Width="30" Height="30" Foreground="#DC2626"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Parmak İzi ve Kart Düzensiz Basım Tespit Merkezi" FontWeight="Bold" FontSize="16" Foreground="#991B1B"/>
                        <TextBlock Text="Parmak izini tek basıp çıkanlar, sabah basıp akşam basmayanlar, aşırı geç kalanlar ve erken çıkanlar burada listelenir." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Dışa Aktar Butonu -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Düzensiz Kayıtları Excel'e Aktar" Click="BtnExportExcel_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#DC2626" BorderBrush="#B91C1C" Foreground="White" FontWeight="Bold" Height="34"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. ÖZET İSTATİSTİK ŞERİDİ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kart 1: Toplam Düzensiz Kayıt -->
            <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource ModernGlassCard}" Padding="12,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24" Foreground="#DC2626" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="TOPLAM DÜZENSİZ BASIM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtTotalIrregular" Text="0 Kayıt" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kart 2: Tek Basım / Çıkış Yok -->
            <Border Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource ModernGlassCard}" Padding="12,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FingerprintOff" Width="24" Height="24" Foreground="#D97706" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="TEK BASIM (ÇIKIŞ BASMAYANLAR)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtMissingOut" Text="0 Kişi" FontSize="16" FontWeight="Bold" Foreground="#D97706"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kart 3: Düzensiz Geçiş / Erken Çıkış -->
            <Border Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource ModernGlassCard}" Padding="12,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockAlertOutline" Width="24" Height="24" Foreground="#4F46E5" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="GEÇ GİRİŞ &amp; ERKEN ÇIKIŞ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtLateEarly" Text="0 Kayıt" FontSize="16" FontWeight="Bold" Foreground="#4F46E5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. DETAYLI DÜZENSİZ BASIM TABLOSU -->
        <Border Grid.Row="2" Style="{StaticResource ModernGlassCard}" Padding="12">
            <DataGrid x:Name="dgIrregular" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserResizeColumns="True"
                      Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#FEF2F2"
                      BorderThickness="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#FCA5A5" VerticalGridLinesBrush="#E2E8F0"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Personel ID" Binding="{Binding UserId}" Width="90"/>
                    <DataGridTextColumn Header="Ad Soyad" Binding="{Binding EmployeeName}" Width="150"/>
                    <DataGridTextColumn Header="Departman / Grup" Binding="{Binding GroupName}" Width="120"/>
                    <DataGridTextColumn Header="Statü / Tür" Binding="{Binding EmploymentType}" Width="100"/>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateString}" Width="100"/>
                    <DataGridTextColumn Header="Gün" Binding="{Binding DayType}" Width="90"/>
                    <DataGridTextColumn Header="İlk Giriş" Binding="{Binding ActualFirstIn}" Width="90"/>
                    <DataGridTextColumn Header="Son Çıkış" Binding="{Binding ActualLastOut}" Width="90"/>
                    <DataGridTextColumn Header="Geç Kalma (dk)" Binding="{Binding LateMinutes}" Width="105"/>
                    <DataGridTextColumn Header="Eksik Çalışma" Binding="{Binding MissingWorkHoursDisplay}" Width="105"/>
                    <DataGridTextColumn Header="⚠️ DÜZENSİZLİK NEDENİ &amp; İKAZI" Binding="{Binding Status}" Width="*" FontWeight="Bold" Foreground="#B91C1C"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>