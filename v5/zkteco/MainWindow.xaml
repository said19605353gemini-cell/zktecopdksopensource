                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateString}" Width="100"/>
                                    <DataGridTextColumn Header="Gün" Binding="{Binding DayType}" Width="95"/>
                                    <DataGridTextColumn Header="İlk Giriş" Binding="{Binding ActualFirstIn}" Width="90"/>
                                    <DataGridTextColumn Header="Son Çıkış" Binding="{Binding ActualLastOut}" Width="90"/>
                                    <DataGridTextColumn Header="12 Öncesi Çal." Binding="{Binding DayWorkHoursDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="12 Sonrası Gece" Binding="{Binding NightWorkHoursDisplay}" Width="115"/>
                                    <DataGridTextColumn Header="Mola(dk)" Binding="{Binding ActualBreakMinutes}" Width="85"/>
                                    <DataGridTextColumn Header="Mola Aşımı(dk)" Binding="{Binding ExcessBreakMinutes}" Width="95"/>
                                    <DataGridTextColumn Header="Net Çalışma" Binding="{Binding NetWorkHoursDisplay}" Width="105"/>
                                    <DataGridTextColumn Header="Sabah Mesai" Binding="{Binding MorningOvertimeHoursDisplay}" Width="100"/>
