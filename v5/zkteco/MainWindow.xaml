<Window x:Class="ZkPdksApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ZKTeco PDKS Kurumsal Yönetim Sistemi - Vardiya, Biyometrik &amp; Bordro Puantaj" Height="820" Width="1380"
        MinHeight="650" MinWidth="1050"
        TextElement.Foreground="#0F172A"
        Background="#F1F5F9"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Kurumsal Kart Stili (Modern Executive Card) -->
        <Style x:Key="ModernGlassCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1.5" Opacity="0.05" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Kart Stili (Prestijli Kurumsal Kart) -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1.5" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Yuvarlak Giriş Kutusu Stili (Pill / Tag Box) -->
        <Style x:Key="ModernInputBox" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" Foreground="#0F172A"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Soru İşareti Yardım Butonu Stili -->
        <Style x:Key="HelpQuestionBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST HEADER & BAĞLANTI KARTI -->
        <Border Grid.Row="0" Style="{StaticResource ModernGlassCard}" Padding="16,14" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#EFF6FF" Padding="8" Margin="0,0,14,0" BorderBrush="#BFDBFE" BorderThickness="1">
                        <materialDesign:PackIcon Kind="Fingerprint" Width="34" Height="34" VerticalAlignment="Center" Foreground="#1E40AF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="lblAppTitle" Text="ZKTeco PDKS" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#1E40AF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ENTERPRISE 2026" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="lblAppSubtitle" Text="Taşeron &amp; Personel Yönetimi • Gece/Gündüz Ayrımı • Çoklu Vardiya &amp; Hakediş Puantajı" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="6,2" Margin="0,0,8,4" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="IpNetwork" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <TextBox x:Name="txtIpAddress" Text="127.0.0.1" Width="85" Foreground="#0F172A" BorderThickness="0" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Text=":" Foreground="#64748B" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="txtPort" Text="4370" Width="40" Foreground="#0F172A" BorderThickness="0" VerticalAlignment="Center" FontSize="12" Margin="2,0,2,0"/>
                            <Button Style="{StaticResource HelpQuestionBtn}" Tag="IpPort" Click="BtnHelp_Click" ToolTip="Cihaz IP ve Port Bilgisi">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnConnect" Content="Cihaza Bağlan" Click="BtnConnect_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E40AF" BorderBrush="#1D4ED8" Foreground="White" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="Connect" Click="BtnHelp_Click" Margin="0,0,6,4" ToolTip="Cihaza Bağlanma Hakkında Bilgi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <Button x:Name="btnGetLogs" Content="Logları Çek" Click="BtnGetLogs_Click" Style="{StaticResource MaterialDesignRaisedAccentButton}" Background="#0D9488" BorderBrush="#0F766E" Foreground="White" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="GetLogs" Click="BtnHelp_Click" Margin="0,0,6,4" ToolTip="Logları Çekme Hakkında Bilgi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <Button x:Name="btnSyncDeviceTime" Content="Cihaz Saatini Eşitle" Click="BtnSyncDeviceInternetTime_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#059669" BorderBrush="#047857" Foreground="White" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold" ToolTip="Cihazın saatini ve takvimini Türkiye canlı internet saatine eşitler"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="SyncDeviceTime" Click="BtnHelp_Click" Margin="0,0,6,4" ToolTip="Saat Eşitleme Hakkında Bilgi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <Button x:Name="btnEmployees" Content="Personel Özlük" Click="BtnEmployees_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#94A3B8" Foreground="#334155" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="Employees" Click="BtnHelp_Click" Margin="0,0,6,4" ToolTip="Personel Özlük Yönetimi Bilgisi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <Button x:Name="btnGroups" Content="Grup &amp; Statü" Click="BtnGroupManagement_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#6366F1" Foreground="#4F46E5" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="Groups" Click="BtnHelp_Click" Margin="0,0,6,4" ToolTip="Grup ve Statü Yönetimi Bilgisi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <Button x:Name="btnShifts" Content="Mesai &amp; Kurallar" Click="BtnShifts_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#94A3B8" Foreground="#334155" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="Shifts" Click="BtnHelp_Click" Margin="0,0,6,4" ToolTip="Vardiya ve Mesai Kuralları Bilgisi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <Button x:Name="btnShiftSchedule" Content="Haftalık Vardiya Çizelgesi" Click="BtnShiftSchedule_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4338CA" BorderBrush="#3730A3" Foreground="White" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="ShiftSchedule" Click="BtnHelp_Click" Margin="0,0,6,4" ToolTip="Tarih Bazlı Haftalık/Aylık Vardiya Değişimi Bilgisi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <Button x:Name="btnIrregularPunches" Content="⚠️ Düzensiz Basımlar" Click="BtnIrregularPunches_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#DC2626" BorderBrush="#B91C1C" Foreground="White" Height="32" Padding="8,0" Margin="0,0,2,4" FontWeight="SemiBold" ToolTip="Parmak izini düzgün basmayanları, tek basıp çıkanları ayrı pencerede listeler"/>
                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="IrregularPunches" Click="BtnHelp_Click" Margin="0,0,8,4" ToolTip="Düzensiz Basım Takibi Bilgisi">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                    </Button>

                    <!-- Dil Seçim Kutucuğu (Language Selector) -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="4,2" Margin="0,0,0,4" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Translate" Width="16" Height="16" Foreground="#4F46E5" VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <ComboBox x:Name="cbLanguage" Width="100" Foreground="#0F172A" BorderThickness="0" FontSize="12" SelectionChanged="CbLanguage_SelectionChanged">
                                <ComboBoxItem Tag="tr" Content="🇹🇷 Türkçe" IsSelected="True"/>
                                <ComboBoxItem Tag="ku" Content="☀️ Kurdî"/>
                                <ComboBoxItem Tag="en" Content="🇬🇧 English"/>
                                <ComboBoxItem Tag="de" Content="🇩🇪 Deutsch"/>
                                <ComboBoxItem Tag="ru" Content="🇷🇺 Русский"/>
                                <ComboBoxItem Tag="ar" Content="🇸🇦 العربية"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 2. ÖZET İSTATİSTİK & CİHAZ SAAT TAKİP KARTLARI -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Kart 1: Bağlantı Durumu -->
            <Border Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource KpiCard}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#EFF6FF" Padding="8" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="LanConnect" Width="24" Height="24" Foreground="#2563EB"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="lblKpiConnection" Text="CİHAZ VE HAT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtConnectionStatus" Text="Bağlantı Yok" FontSize="14" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kart 2: Cihaz Saati & RTC Takibi -->
            <Border Grid.Column="1" Margin="4,0,4,0" Style="{StaticResource KpiCard}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Padding="2" Height="28" Width="28" Click="BtnSyncDeviceInternetTime_Click" ToolTip="Cihaz saat ve takvimini Türkiye canlı internet saatiyle eşitle" Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon Kind="Sync" Width="16" Height="16" Foreground="#059669"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="#FEF3C7" Padding="8" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="24" Height="24" Foreground="#D97706"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="lblKpiDeviceTime" Text="CİHAZ SAATİ (RTC)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="txtDeviceTime" Text="Bilinmiyor" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Kart 3: Kayıtlı Personel -->
            <Border Grid.Column="2" Margin="4,0,4,0" Style="{StaticResource KpiCard}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#ECFDF5" Padding="8" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" Foreground="#059669"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="lblKpiEmpCount" Text="KADRO &amp; TAŞERON" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtEmpCount" Text="0 Kişi" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kart 4: Toplam Genel Mesai Saati -->
            <Border Grid.Column="3" Margin="4,0,4,0" Style="{StaticResource KpiCard}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#EFF6FF" Padding="8" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="TimerSand" Width="24" Height="24" Foreground="#1E40AF"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="lblKpiTotalOt" Text="TOPLAM GENEL MESAİ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiTotalOvertime" Text="0.00 Saat" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtStatus" Text="Hazır" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kart 5: Cumartesi Çalışma Toplamı -->
            <Border Grid.Column="4" Margin="4,0,4,0" Style="{StaticResource KpiCard}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#FFFBEB" Padding="8" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CalendarWeek" Width="24" Height="24" Foreground="#D97706"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="lblKpiSatHours" Text="CUMARTESİ ÇALIŞMA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiSaturdayHours" Text="0.00 Saat" FontSize="15" FontWeight="Bold" Foreground="#B45309" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kart 6: Pazar & Tatil Çalışma Toplamı -->
            <Border Grid.Column="5" Margin="4,0,0,0" Style="{StaticResource KpiCard}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#FFF1F2" Padding="8" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CalendarWeekend" Width="24" Height="24" Foreground="#E11D48"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="lblKpiSunHours" Text="PAZAR &amp; TATİL MESAİ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiSundayHours" Text="0.00 Saat" FontSize="15" FontWeight="Bold" Foreground="#BE123C" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. TABLI İÇERİK ALANI -->
        <TabControl Grid.Row="2" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- TAB 1: GELİŞMİŞ VARDİYA, ÇALIŞMA VE FAZLA MESAİ LİMİT RAPORU -->
            <TabItem x:Name="tabReport" Header="  Puantaj &amp; Mesai Raporu  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="6,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filtre ve İşlem Kontrol Paneli -->
                    <Border Grid.Row="0" Style="{StaticResource ModernGlassCard}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <!-- 1. SATIR: TAKVİM, TARİH VE GÜN FİLTRELERİ (Birlikte Uyumlu) -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <!-- Yıl Kutucuğu -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Calendar" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblYear" Text="Yıl:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#475569"/>
                                        <ComboBox x:Name="cbReportYear" Width="75" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbReportDate_SelectionChanged"/>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="PeriodYear" Click="BtnHelp_Click" ToolTip="Yıl Seçimi Bilgisi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Ay Kutucuğu -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CalendarRange" Width="18" Height="18" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblMonth" Text="Ay:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#475569"/>
                                        <ComboBox x:Name="cbReportMonth" Width="110" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbReportDate_SelectionChanged"/>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="PeriodMonth" Click="BtnHelp_Click" ToolTip="Rapor Dönemi Bilgisi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- İki Tarih Arası (Özel Tarih Aralığı) Seçim Kutucuğu -->
                                <Border Style="{StaticResource ModernInputBox}" Background="#F0FDF4" BorderBrush="#86EFAC">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkUseDateRange" Content="Tarih Aralığı:" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" Margin="0,0,6,0" Checked="ChkUseDateRange_Changed" Unchecked="ChkUseDateRange_Changed" ToolTip="İki tarih arasındaki tüm hareketleri ve mesaileri filtreler"/>
                                        <DatePicker x:Name="dpStartDate" Width="105" BorderThickness="0" FontSize="12" Foreground="#0F172A" SelectedDateChanged="DpDateRange_SelectedDateChanged"/>
                                        <TextBlock Text="—" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                        <DatePicker x:Name="dpEndDate" Width="105" BorderThickness="0" FontSize="12" Foreground="#0F172A" SelectedDateChanged="DpDateRange_SelectedDateChanged"/>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="DateRange" Click="BtnHelp_Click" ToolTip="Özel Tarih Aralığı Bilgisi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Hızlı Günlük Seçim Butonu (Bugün) -->
                                <Button x:Name="btnTodayFilter" Click="BtnTodayFilter_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#0D9488" Foreground="#0F766E"
                                        Height="36" Padding="8,0" Margin="0,0,4,0" ToolTip="Sadece bugünkü günlük geçişleri ve mesaiyi listeler">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CalendarToday" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtBtnToday" Text="Bugün (Günlük)" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HelpQuestionBtn}" Tag="TodayFilter" Click="BtnHelp_Click" Margin="0,0,6,0" ToolTip="Bugünlük Puantaj Filtresi Bilgisi">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                </Button>

                                <!-- Gün Tipi Filtresi (Tümü, Hafta İçi, Cumartesi, Pazar, Resmi Tatiller) -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CalendarWeek" Width="18" Height="18" Foreground="#EC4899" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblDay" Text="Gün:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#475569"/>
                                        <ComboBox x:Name="cbReportDayFilter" Width="145" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbReportDayFilter_SelectionChanged">
                                            <ComboBoxItem Content="Tüm Günler" IsSelected="True"/>
                                            <ComboBoxItem Content="Sadece Resmi Tatiller"/>
                                            <ComboBoxItem Content="Resmi Tatil &amp; Hafta Sonu"/>
                                            <ComboBoxItem Content="Cumartesi &amp; Pazar (Hafta Sonu)"/>
                                            <ComboBoxItem Content="Sadece Cumartesi"/>
                                            <ComboBoxItem Content="Sadece Pazar"/>
                                            <ComboBoxItem Content="Sadece Hafta İçi (Normal Günler)"/>
                                        </ComboBox>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="DayFilter" Click="BtnHelp_Click" ToolTip="Gün Filtreleme Bilgisi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Takvimi En Güncel Veri / Log Tarihine Çekme Butonu -->
                                <Button x:Name="btnSyncLatestPeriod" Click="BtnSyncLatestPeriod_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#3B82F6" Foreground="#1D4ED8"
                                        Height="36" Padding="8,0" Margin="0,0,4,0" ToolTip="Takvimi ve raporu cihazdaki / veritabanındaki en son hareket tarihine konumlandırır">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CalendarSync" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtBtnLatestPeriod" Text="Son Veri Dönemine Git" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HelpQuestionBtn}" Tag="SyncLatestPeriod" Click="BtnHelp_Click" Margin="0,0,6,0" ToolTip="Son Veri Dönemine Gitme Bilgisi">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                </Button>

                                <!-- Türkiye Canlı İnternet Saati & Tarihine Eşitleme Butonu -->
                                <Button x:Name="btnSyncInternetTime" Click="BtnSyncInternetTime_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#059669" Foreground="#047857"
                                        Height="36" Padding="8,0" Margin="0,0,4,0" ToolTip="Türkiye resmi saat ve tarihini internetten çeker, takvimi güncel aya odaklar ve cihaz saatini günceller">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="WebClock" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtBtnInternetTime" Text="Türkiye Canlı Tarih/Saat" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HelpQuestionBtn}" Tag="SyncInternetTimeBtn" Click="BtnHelp_Click" Margin="0,0,6,0" ToolTip="Türkiye Canlı Tarih/Saat Bilgisi">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                </Button>

                                <!-- Resmi Tatilleri İnternetten Güncelleme Butonu -->
                                <Button x:Name="btnRefreshHolidays" Click="BtnRefreshHolidays_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#E11D48" Foreground="#BE123C"
                                        Height="36" Padding="8,0" Margin="0,0,4,0" ToolTip="Seçili yılın Türkiye resmi tatillerini internetten çeker ve günceller">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CloudDownload" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtBtnUpdateHolidays" Text="Tatilleri Güncelle" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HelpQuestionBtn}" Tag="RefreshHolidays" Click="BtnHelp_Click" Margin="0,0,10,0" ToolTip="Tatilleri Güncelleme Bilgisi">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                </Button>
                            </WrapPanel>

                            <!-- 2. SATIR: PERSONEL ÖZLÜK FİLTRELERİ VE BUTONLAR -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Grup Filtresi Kutucuğu -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountMultiple" Width="18" Height="18" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblGroup" Text="Grup:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#475569"/>
                                        <ComboBox x:Name="cbReportGroup" Width="125" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbReportGroup_SelectionChanged"/>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="GroupFilter" Click="BtnHelp_Click" ToolTip="Grup Filtreleme Bilgisi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- İstihdam Türü Filtresi (Kadrolu, Taşeron vb.) -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="BriefcaseOutline" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblType" Text="Tür:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#475569"/>
                                        <ComboBox x:Name="cbReportEmploymentTypeFilter" Width="110" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbReportEmploymentTypeFilter_SelectionChanged"/>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="TypeFilter" Click="BtnHelp_Click" ToolTip="Tür/Taşeron Filtresi Bilgisi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Personel Durumu / Statü Filtresi (Aktif, Pasif, İzinli) -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountCheck" Width="18" Height="18" Foreground="#6366F1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblStatus" Text="Statü:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#475569"/>
                                        <ComboBox x:Name="cbReportStatusFilter" Width="120" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbReportStatusFilter_SelectionChanged">
                                            <ComboBoxItem Content="Tümü (Tüm Personel)" IsSelected="True"/>
                                            <ComboBoxItem Content="Sadece Aktif Olanlar"/>
                                            <ComboBoxItem Content="Pasif (Ayrılanlar)"/>
                                            <ComboBoxItem Content="İzinli Olanlar"/>
                                        </ComboBox>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="StatusFilter" Click="BtnHelp_Click" ToolTip="Personel Statü Filtresi Bilgisi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Ad Soyad Arama / Filtreleme Kutusu -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtSearchName" Width="115" materialDesign:HintAssist.Hint="Ad Soyad Ara..." BorderThickness="0" FontSize="12" Foreground="#0F172A" TextChanged="TxtSearch_TextChanged"/>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="SearchNameTc" Click="BtnHelp_Click" ToolTip="Arama Hakkında Bilgi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- T.C. No Arama / Filtreleme Kutusu -->
                                <Border Style="{StaticResource ModernInputBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="18" Height="18" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtSearchTc" Width="95" materialDesign:HintAssist.Hint="T.C. No Ara..." BorderThickness="0" FontSize="12" Foreground="#0F172A" TextChanged="TxtSearch_TextChanged"/>
                                        <Button Style="{StaticResource HelpQuestionBtn}" Tag="SearchNameTc" Click="BtnHelp_Click" ToolTip="T.C. Arama Hakkında Bilgi">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnCalculate" Content="Hesapla" Click="BtnCalculateReport_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E40AF" BorderBrush="#1D4ED8" Foreground="White" Margin="0,0,8,0" FontWeight="Bold" Height="34"/>
                                <Button x:Name="btnClearFilters" Click="BtnClearFilters_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#E11D48" Foreground="#BE123C" Height="34" Margin="0,0,8,0" FontWeight="Bold" ToolTip="Tüm arama ve grup/tür/gün filtrelerini sıfırlar">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtBtnClearFilters" Text="Filtreleri Sıfırla" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnExportMonthly" Content="Bordro Excel'e Aktar" Click="BtnExportMonthlyReport_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#059669" Foreground="#047857" FontWeight="Bold" Height="34" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource HelpQuestionBtn}" Tag="ExportMonthly" Click="BtnHelp_Click" Margin="0,0,8,0" ToolTip="Bordro Excel Çıktısı Bilgisi">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                </Button>
                                <Button x:Name="btnExportDaily" Content="Gün Gün Puantaj Excel'e Aktar" Click="BtnExportDailyAttendance_Click" Style="{StaticResource MaterialDesignRaisedAccentButton}" Background="#0D9488" BorderBrush="#0F766E" Foreground="White" FontWeight="Bold" Height="34" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource HelpQuestionBtn}" Tag="ExportDaily" Click="BtnHelp_Click" Margin="0,0,8,0" ToolTip="Gün Gün Puantaj Excel Çıktısı Bilgisi">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rapor Tablosu -->
                    <Border Grid.Row="1" Style="{StaticResource ModernGlassCard}" Padding="4">
                        <DataGrid x:Name="dgMonthlyReport" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="70"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding EmployeeName}" Width="150"/>
                                <DataGridTextColumn Header="T.C. No" Binding="{Binding TcNo}" Width="110"/>
                                <DataGridTextColumn Header="Durum" Binding="{Binding EmployeeStatus}" Width="85"/>
                                <DataGridTextColumn Header="Grup" Binding="{Binding GroupName}" Width="110"/>
                                <DataGridTextColumn Header="Tür" Binding="{Binding EmploymentType}" Width="100"/>
                                <DataGridTextColumn Header="Şahsi Tel" Binding="{Binding Phone}" Width="110"/>
                                <DataGridTextColumn Header="Firma Tel" Binding="{Binding CompanyPhone}" Width="110"/>
                                <DataGridTextColumn Header="İşe Giriş (Aktif)" Binding="{Binding HireDate}" Width="110"/>
                                <DataGridTextColumn Header="Ayrılış (Pasif)" Binding="{Binding LeaveDate}" Width="110"/>
                                <DataGridTextColumn Header="Departman" Binding="{Binding Department}" Width="110"/>
                                <DataGridTextColumn Header="Unvan" Binding="{Binding Title}" Width="110"/>
                                <DataGridTextColumn Header="Vardiya" Binding="{Binding ShiftName}" Width="140"/>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding DateString}" Width="105"/>
                                <DataGridTextColumn Header="Gün" Binding="{Binding DayType}" Width="95"/>
                                <DataGridTextColumn Header="İlk Giriş" Binding="{Binding ActualFirstIn}" Width="90"/>
                                <DataGridTextColumn Header="Son Çıkış" Binding="{Binding ActualLastOut}" Width="90"/>
                                
                                <DataGridTextColumn Header="12 Öncesi Çal." Binding="{Binding DayWorkHoursDisplay}" Width="110"/>
                                <DataGridTextColumn Header="12 Sonrası Gece" Binding="{Binding NightWorkHoursDisplay}" Width="115"/>
                                <DataGridTextColumn Header="Fiili Mola(dk)" Binding="{Binding ActualBreakMinutes}" Width="95"/>
                                <DataGridTextColumn Header="Mola Aşımı(dk)" Binding="{Binding ExcessBreakMinutes}" Width="100"/>
                                <DataGridTextColumn Header="Net Çalışma" Binding="{Binding NetWorkHoursDisplay}" Width="110"/>
                                
                                <!-- 3'lü Ayrıntılı Mesai Ayrımı: Sabah, Akşam, Gece -->
                                <DataGridTextColumn Header="Sabah Mesai" Binding="{Binding MorningOvertimeHoursDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Akşam Mesai" Binding="{Binding EveningOvertimeHoursDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Gece Mesai" Binding="{Binding NightShiftOvertimeHoursDisplay}" Width="110"/>

                                <!-- Onaylanan ve Limiti Aşan Mesailer -->
                                <DataGridTextColumn Header="Ham Mesai" Binding="{Binding ApprovedOvertimeDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Çarpan" Binding="{Binding OvertimeMultiplier}" Width="80"/>
                                <DataGridTextColumn Header="Hakediş Mesai" Binding="{Binding WeightedOvertimeHoursDisplay}" Width="115"/>
                                <DataGridTextColumn Header="İptal / Aşan" Binding="{Binding RejectedOvertimeDisplay}" Width="100"/>
                                
                                <DataGridTextColumn Header="Geç Kalma (dk)" Binding="{Binding LateMinutes}" Width="105"/>
                                <DataGridTextColumn Header="Eksik" Binding="{Binding MissingWorkHoursDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Mesai / Devamsızlık Durumu" Binding="{Binding Status}" Width="230" MinWidth="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: GEÇİŞ HAREKETLERİ (HER BASTIĞI PARMAK İZİ / KART TABLOSU) -->
            <TabItem x:Name="tabLogs" Header="  Her Bastığı Parmak İzi (Geçiş Logları)  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="6,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModernGlassCard}" Padding="12,10" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Personel ID / İsim Arama -->
                            <Border Style="{StaticResource ModernInputBox}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtLogSearchUser" Width="130" materialDesign:HintAssist.Hint="Personel ID veya İsim..." BorderThickness="0" FontSize="12" Foreground="#0F172A" TextChanged="TxtLogSearch_TextChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- İşlem Tipi Filtresi (Tümü, Giriş, Çıkış, Mola Giriş, Mola Çıkış, Fazla Mesai) -->
                            <Border Style="{StaticResource ModernInputBox}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="18" Height="18" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="İşlem:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                                    <ComboBox x:Name="cbLogTypeFilter" Width="120" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbLogFilter_Changed">
                                        <ComboBoxItem Content="Tüm İşlemler" IsSelected="True"/>
                                        <ComboBoxItem Content="Giriş"/>
                                        <ComboBoxItem Content="Çıkış"/>
                                        <ComboBoxItem Content="Mola Giriş"/>
                                        <ComboBoxItem Content="Mola Çıkış"/>
                                        <ComboBoxItem Content="Fazla Mesai Giriş"/>
                                        <ComboBoxItem Content="Fazla Mesai Çıkış"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Doğrulama Türü (Parmak İzi, Kart, Yüz Tanıma, Şifre) -->
                            <Border Style="{StaticResource ModernInputBox}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Fingerprint" Width="18" Height="18" Foreground="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tür:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                                    <ComboBox x:Name="cbLogVerifyFilter" Width="120" Foreground="#0F172A" BorderThickness="0" SelectionChanged="CbLogFilter_Changed">
                                        <ComboBoxItem Content="Tümü (Tüm Doğrulama)" IsSelected="True"/>
                                        <ComboBoxItem Content="Parmak İzi"/>
                                        <ComboBoxItem Content="Kart (RFID)"/>
                                        <ComboBoxItem Content="Yüz Tanıma"/>
                                        <ComboBoxItem Content="Şifre / Diğer"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Tarih Seçimi -->
                            <Border Style="{StaticResource ModernInputBox}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Calendar" Width="18" Height="18" Foreground="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="dpLogDateFilter" Width="105" BorderThickness="0" FontSize="12" Foreground="#0F172A" SelectedDateChanged="DpLogDateFilter_SelectedDateChanged"/>
                                    <Button Padding="2" Height="22" Width="22" Click="BtnClearLogDate_Click" ToolTip="Tarih Filtresini Temizle" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="14" Height="14" Foreground="#94A3B8"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnRefreshDb" Content="Yenile" Click="BtnLoadDbLogs_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#94A3B8" Foreground="#334155" Height="34" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource HelpQuestionBtn}" Tag="RefreshDb" Click="BtnHelp_Click" Margin="0,0,8,0" ToolTip="Veritabanını Yenileme Bilgisi">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                            </Button>

                            <Button x:Name="btnExportAllLogs" Content="Bu Basımları Excel'e Aktar" Click="BtnExportExcel_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E40AF" BorderBrush="#1D4ED8" Foreground="White" Height="34" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource HelpQuestionBtn}" Tag="ExportAllLogs" Click="BtnHelp_Click" ToolTip="Tüm Hareketleri Excel'e Aktarma Bilgisi">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                            </Button>

                            <TextBlock x:Name="txtFilteredLogCount" Text="0 Basım Kaydı" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E40AF" Margin="12,0,0,0"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ModernGlassCard}" Padding="8">
                        <DataGrid x:Name="dgLogs" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Personel ID" Binding="{Binding UserId}" Width="110"/>
                                <DataGridTextColumn Header="Personel Adı" Binding="{Binding UserName}" Width="190"/>
                                <DataGridTextColumn Header="İşlem Tipi (Giriş/Çıkış)" Binding="{Binding InOutMode}" Width="160"/>
                                <DataGridTextColumn Header="Tarih / Saat" Binding="{Binding LogTime}" Width="190"/>
                                <DataGridTextColumn Header="Doğrulama Türü (Parmak İzi/Kart/Yüz)" Binding="{Binding VerifyMode}" Width="230"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: PERSONEL BİLGİ & ÇALIŞMA ÖZET KARTI (360 DERECE PANEL) -->
            <TabItem x:Name="tabEmpPanel" Header="  Personel Bilgi &amp; Özet Paneli  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="6,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Üst Personel Seçim Çubuğu -->
                    <Border Grid.Row="0" Style="{StaticResource ModernGlassCard}" Padding="12,10" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountSearch" Width="22" Height="22" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="lblInspectEmp" Text="İncelenecek Personel:" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,8,0"/>
                            
                            <!-- Personel Seçim ComboBox'ı -->
                            <Border Style="{StaticResource ModernInputBox}" Padding="4,2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="cbSelectedEmployeeCard" Width="190" Foreground="#0F172A" BorderThickness="0" FontSize="12"
                                              SelectionChanged="CbSelectedEmployeeCard_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Badgenumber"/>
                                    <Button Style="{StaticResource HelpQuestionBtn}" Tag="EmpCardSelect" Click="BtnHelp_Click" ToolTip="Personel Seçim Bilgisi">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- İsim ile Arama Kutusu -->
                            <Border Style="{StaticResource ModernInputBox}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountBoxOutline" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtCardSearchName" Width="110" materialDesign:HintAssist.Hint="İsimle Ara..." BorderThickness="0" FontSize="12" Foreground="#0F172A" TextChanged="TxtCardSearch_TextChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- T.C. No ile Arama Kutusu -->
                            <Border Style="{StaticResource ModernInputBox}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="16" Height="16" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtCardSearchTc" Width="95" materialDesign:HintAssist.Hint="T.C. ile Ara..." BorderThickness="0" FontSize="12" Foreground="#0F172A" TextChanged="TxtCardSearch_TextChanged"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnExportEmpDetail" Content="Bu Personelin Aylık Detayını Excel'e Aktar" Click="BtnExportSingleEmpExcel_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E40AF" BorderBrush="#1D4ED8" Foreground="White" FontWeight="SemiBold" Height="34" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource HelpQuestionBtn}" Tag="ExportEmpDetail" Click="BtnHelp_Click" Margin="0,0,8,0" ToolTip="Personel Detayını Excel'e Aktarma Bilgisi">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                            </Button>
                            <Button x:Name="btnRefreshEmpDetail" Content="Yenile" Click="BtnRefreshEmpDetail_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#2563EB" Foreground="#1D4ED8" FontWeight="SemiBold" Height="34"/>
                        </WrapPanel>
                    </Border>

                    <!-- Alt Detay Kartları -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" MinWidth="260" MaxWidth="380"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol Kart: Personelin Tüm Özlük & Sistem Bilgileri -->
                        <Border Grid.Column="0" Style="{StaticResource ModernGlassCard}" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border CornerRadius="30" Width="56" Height="56" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <materialDesign:PackIcon Kind="Account" Width="34" Height="34" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="txtCardEmpName" Text="Personel Seçiniz" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock x:Name="txtCardEmpBadge" Text="ID: -" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

