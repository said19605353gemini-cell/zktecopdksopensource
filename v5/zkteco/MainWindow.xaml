                                    <DataGridTextColumn Header="Çarpan" Binding="{Binding OvertimeMultiplier}" Width="75"/>
                                    <DataGridTextColumn Header="Hakediş Mesai" Binding="{Binding WeightedOvertimeHoursDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="Geç Kalma (dk)" Binding="{Binding LateMinutes}" Width="100"/>
                                    <DataGridTextColumn Header="Eksik" Binding="{Binding MissingWorkHoursDisplay}" Width="95"/>
                                    <DataGridTextColumn Header="Puantaj / Mesai Durumu" Binding="{Binding Status}" Width="260" MinWidth="200"/>
                                </DataGrid.Columns>
