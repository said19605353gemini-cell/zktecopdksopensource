<Window x:Class="ZkPdksApp.DeviceSyncConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cihaz Saati, Resmi Tatil &amp; Takvim Ülke Ayarları" Height="700" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        ResizeMode="NoResize"
        TextElement.Foreground="#0F172A">

    <Window.Resources>
        <Style x:Key="ModernGlassCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Color="#0F172A" Opacity="0.04" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpQuestionBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK & AÇIKLAMA -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
            <DockPanel>
                <materialDesign:PackIcon Kind="WebClock" Width="36" Height="36" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderTitle" Text="Cihaz Saati, Resmi Tatil &amp; Takvim Yönetim Paneli" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="txtHeaderSubtitle" Text="ZKTeco cihazının RTC saati, resmi tatil çekimleri ve takvim eşitlemelerini ülke ve saat dilimlerine göre bağımsız yönetin." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ORTA İÇERİK KARTLARI -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. BÖLÜM: CİHAZ SAATİ GÜNCELLEME ÜLKESİ & SAAT DİLİMİ -->
                <Border Style="{StaticResource ModernGlassCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="ClockCheckOutline" Width="22" Height="22" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtSec1Title" Text="1. Cihaz Saati (RTC) Güncelleme Ülkesi" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource HelpQuestionBtn}" Tag="Help_DeviceClock" Click="BtnSectionHelp_Click" Margin="8,0,0,0" HorizontalAlignment="Left" ToolTip="Cihaz Saati Güncelleme Ülkesi Nedir?">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18"/>
                            </Button>
                        </DockPanel>
                        <TextBlock x:Name="txtSec1Desc" Text="Cihaz saatini eşitlediğinizde, terminalin içindeki donanımsal saat (RTC) bu seçilen ülkenin resmi saat dilimine (Canlı İnternet Saati) ayarlanır." 
                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblTargetClockCountry" Text="Hedef Ülke / Saat Dilimi:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cbDeviceClockCountry" Grid.Column="1" Height="34" FontSize="12" Foreground="#0F172A" SelectionChanged="CbDeviceClockCountry_SelectionChanged"/>
                            <Button x:Name="btnExecuteDeviceClockSync" Grid.Column="2" Content="Cihaz Saatini Şimdi Güncelle" Click="BtnExecuteDeviceClockSync_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#059669" BorderBrush="#047857" Foreground="White" FontWeight="Bold" Height="34" Margin="10,0,0,0"/>
                        </Grid>

                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="lblClockPreview" Text="Seçilen Ülke Saati Önizleme: Hesaplanıyor..." FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                                <TextBlock x:Name="lblClockInfo" Text="Saat Dilimi: UTC+3 · Turkey Standard Time" FontSize="11" Foreground="#166534" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. BÖLÜM: RESMİ TATİLLERİ GÜNCELLEME ÜLKESİ -->
                <Border Style="{StaticResource ModernGlassCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CalendarStar" Width="22" Height="22" Foreground="#E11D48" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtSec2Title" Text="2. Resmi Tatilleri Güncelleme Ülkesi" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource HelpQuestionBtn}" Tag="Help_Holidays" Click="BtnSectionHelp_Click" Margin="8,0,0,0" HorizontalAlignment="Left" ToolTip="Resmi Tatiller Güncelleme Ülkesi Nedir?">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18" Foreground="#E11D48"/>
                            </Button>
                        </DockPanel>
                        <TextBlock x:Name="txtSec2Desc" Text="Puantaj raporundaki resmi tatil günleri, dini bayramlar ve resmi izinler burada seçilen ülkenin uluslararası tatil veritabanından (Nager.Date API) çekilir ve mesai çarpanlarına yansıtılır." 
                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblTargetHolidayCountry" Text="Tatil Çekilecek Ülke:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cbHolidayCountry" Grid.Column="1" Height="34" FontSize="12" Foreground="#0F172A" SelectionChanged="CbHolidayCountry_SelectionChanged"/>
                            <Button x:Name="btnExecuteHolidaySync" Grid.Column="2" Content="Resmi Tatilleri Şimdi Çek" Click="BtnExecuteHolidaySync_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#E11D48" BorderBrush="#BE123C" Foreground="White" FontWeight="Bold" Height="34" Margin="10,0,0,0"/>
                        </Grid>

                        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="lblHolidayInfo" Text="Örnek: Almanya seçilirse Alman eyalet ve federal tatilleri çekilir; Türkiye seçilirse milli ve dini bayramlar çekilir." FontSize="11" Foreground="#9F1239"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. BÖLÜM: TAKVİM & CANLI İNTERNET SAATİ EŞİTLEME ÜLKESİ -->
                <Border Style="{StaticResource ModernGlassCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="WebClock" Width="22" Height="22" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtSec3Title" Text="3. Takvim &amp; Canlı Saat Odaklama Ülkesi" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource HelpQuestionBtn}" Tag="Help_Calendar" Click="BtnSectionHelp_Click" Margin="8,0,0,0" HorizontalAlignment="Left" ToolTip="Takvim Odaklama Ülkesi Nedir?">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18" Foreground="#0284C7"/>
                            </Button>
                        </DockPanel>
                        <TextBlock x:Name="txtSec3Desc" Text="Ana ekrandaki canlı tarih/saat butonu ve takvim odağı bu ülkenin güncel yıl, ay ve gününe göre filtrelenir." 
                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblTargetCalendarCountry" Text="Takvim Odak Ülkesi:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cbCalendarCountry" Grid.Column="1" Height="34" FontSize="12" Foreground="#0F172A" SelectionChanged="CbCalendarCountry_SelectionChanged"/>
                            <Button x:Name="btnExecuteCalendarSync" Grid.Column="2" Content="Takvimi Bu Ülkeye Eşitle" Click="BtnExecuteCalendarSync_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#0284C7" BorderBrush="#0369A1" Foreground="White" FontWeight="Bold" Height="34" Margin="10,0,0,0"/>
                        </Grid>

                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="lblCalendarInfo" Text="Saat dilimi farkından dolayı gece yarısı gün değişimlerinde (örneğin ABD New York veya Japonya) takvim otomatik o ülkenin gününe ayarlanır." FontSize="11" Foreground="#0369A1"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ALT BUTONLAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="txtFooterTip" Text="💡 İpucu: Bu paneldeki ayarlar dil seçiminden bağımsızdır; farklı ülkelerdeki fabrikalarınızı ayrı ayrı yönetebilirsiniz." 
                           VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                <Button x:Name="btnClose" Content="Kapat" Click="BtnClose_Click" HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#475569" Foreground="White" Height="32" Padding="16,0" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>